{
  "name": "mekholi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mekholi — a universal retail POS platform with a plugin architecture.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate:migrations": "node tools/validate-migrations.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:boundaries && npm run test && npm run validate:migrations && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "db:push": "node tools/db-push.mjs",
    "db:status": "node tools/db-push.mjs --status",
    "db:seed": "node tools/db-push.mjs --seed",
    "db:reset": "node tools/db-reset.mjs --yes",
    "e2e": "node tools/e2e-http.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@eslint/js": "^9.12.0",
    "@types/node": "^20.16.10",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^3.0.3",
    "eslint": "^9.12.0",
    "jsdom": "^29.1.1",
    "pg": "^8.23.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.8",
    "vitest": "^4.1.11"
  }
}
