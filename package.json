{
  "name": "mekholi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mekholi \u2014 a universal retail POS platform with a plugin architecture.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate:migrations": "node tools/validate-migrations.mjs",
    "check": "npm run typecheck && npm run lint && npm run validate:migrations && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@eslint/js": "^9.12.0",
    "@types/node": "^20.16.10",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.12.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.8"
  }
}
