# Mekholi — environment
#
# Copy to `.env` and fill in. `.env` is gitignored; `.env.example` is committed.
#
# Only variables prefixed `VITE_` reach the browser. Anything prefixed `VITE_`
# is PUBLIC — never put a secret in one. In particular the Supabase
# service-role key must NEVER appear here; it belongs only in
# `supabase/functions/*` deployed via the Supabase CLI (docs/02 §8, spec §44).

# Supabase project — Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://tjhodyveonlzabjaaino.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_iMTUYlxX08qZk_4Bd9neVA_RkLRgxNN

# Application environment. One of: development | staging | production
VITE_APP_ENV=development

# Build-time gate for the demo data source. When false, Vite tree-shakes
# DemoDataSource out of the bundle entirely — the code is absent, not merely
# unreachable (docs/09 #13). Never make this a runtime toggle.
VITE_ENABLE_DEMO=false

# Product name shown in the UI, setup wizard, receipts and invoice headers.
VITE_APP_NAME=Mekholi

# ImgBB public API key — product photos and the shop logo (docs/15).
#
# Get one at https://api.imgbb.com. It is a *public* upload key by ImgBB's own
# design: it can upload and nothing else, so shipping it in the bundle is safe.
# Leave it blank and image uploads switch off cleanly — the picker renders
# disabled with an explanation and every other field keeps working.
VITE_IMGBB_API_KEY=
