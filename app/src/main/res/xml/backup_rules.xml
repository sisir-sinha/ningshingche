<?xml version="1.0" encoding="utf-8"?><!--
   Cloud backup rules (Android 11 and below; see data_extraction_rules.xml for 12+).

   Nothing here is worth restoring, and some of it is a credential: the Supabase
   session (access and refresh tokens) lives in DataStore under files/datastore, so
   carrying it into a cloud backup would move a signed-in reader's session onto
   another device. Everything is therefore excluded; the app re-creates what it
   needs from the network on first launch.
-->
<full-backup-content>
    <exclude domain="file" path="datastore" />
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
</full-backup-content>
